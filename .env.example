# Environment Configuration Template for PriceWise LK

# ==============================================================================
# 1. Supabase / PostgreSQL Configuration
# ==============================================================================
# Your Supabase Project URL (found in Project Settings -> API)
VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_URL=https://your-project.supabase.co

# Public anonymous key (Safe for frontend exposure, restricted by RLS)
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service Role Secret Key (Privileged database write access for Collector ONLY)
# NEVER commit this key or expose it to frontend code or public clients!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ==============================================================================
# 2. Collector Configuration
# ==============================================================================
# Set to 'supabase' to write directly to database, or 'local' for local JSON storage mode
COLLECTOR_STORAGE_MODE=supabase

# Rate limiting delay between supermarket HTTP requests (milliseconds)
COLLECTOR_REQUEST_DELAY_MS=2000

# Timeout per HTTP request (seconds)
COLLECTOR_HTTP_TIMEOUT_SECONDS=20

# Maximum number of retry attempts for transient HTTP failures
COLLECTOR_MAX_RETRIES=3

# Logging Level: Debug, Information, Warning, Error
LOG_LEVEL=Information
