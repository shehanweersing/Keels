# PriceWise LK — Environment Variables Template
# Copy this file to .env and configure your actual keys.
# NEVER commit .env to public repositories!

# ==============================================================================
# 1. Supabase / PostgreSQL Configuration
# ==============================================================================
# Your Supabase Project URL (found in Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_URL=https://your-project-ref.supabase.co

# Public anonymous key (Safe for frontend exposure, restricted by RLS)
# In Supabase's new key system, this starts with sb_publishable_... or legacy JWT eyJhbGci...
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Service Role Secret Key (Privileged database write access for Collector ONLY)
# In Supabase's new key system, this starts with sb_secret_... or legacy JWT eyJhbGci...
# NEVER expose this key to frontend code or client-side bundles!
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# ==============================================================================
# 2. Collector Configuration
# ==============================================================================
# Set to 'supabase' to write directly to PostgreSQL, or 'local' for local JSON storage mode
COLLECTOR_STORAGE_MODE=supabase

# Rate limiting delay between supermarket HTTP requests (milliseconds)
COLLECTOR_REQUEST_DELAY_MS=2000

# Timeout per HTTP request (seconds)
COLLECTOR_HTTP_TIMEOUT_SECONDS=20

# Maximum number of retry attempts for transient HTTP failures
COLLECTOR_MAX_RETRIES=3

# Logging Level: Debug, Information, Warning, Error
LOG_LEVEL=Information
